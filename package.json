{
  "name": "@local/dsh-jenkins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jenkins panel in the DSH sidebar: connect a Jenkins server, browse jobs, inspect the build queue, and trigger builds.",
  "license": "MIT",
  "author": "ELAscx",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jenkins",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ELAscx/dsh-jenkins-panel.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
